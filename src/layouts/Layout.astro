---
import { buildPageMeta } from "@/seo";
import "@/styles/globals.css";

interface Props {
	title?: string;
	description?: string;
}

const { title = "astro-on-cf", description = "Astro on Cloudflare Workers" } = Astro.props;

// Every link-preview tag comes from here. Adding one — a preview image, a locale —
// is an edit in src/seo/, and src/seo/index.test.ts fails if a tag name is written
// into this file instead.
const { canonical, tags } = buildPageMeta({
	title,
	description,
	site: Astro.site,
	url: Astro.url,
});
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		{tags.map((tag) => <meta {...tag} />)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<!-- Launched from the home screen, the game runs without browser bars: the only fullscreen an iPhone gives a page. -->
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
		<slot />
	</body>
</html>
