---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Śrubek" description="Platformówka na złomowisku">
	<main class="flex min-h-screen flex-col items-center justify-center gap-4 p-4">
		<h1 class="font-mono text-2xl tracking-widest">ŚRUBEK</h1>
		<canvas id="game" width="480" height="256" class="w-full max-w-[960px] bg-neutral-900 [image-rendering:pixelated]" aria-label="Gra Śrubek"></canvas>
		<p class="font-mono text-xs text-neutral-400">strzałki / WASD: bieg · spacja: skok (przytrzymaj, by skoczyć wyżej; w locie raz jeszcze) · E / X / Shift: magnes</p>
	</main>
</Layout>

<script>
	import { start } from "@/game/main";

	const canvas = document.getElementById("game");
	if (canvas instanceof HTMLCanvasElement) start(canvas);
</script>
