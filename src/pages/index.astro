---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Śrubek" description="Platformówka na złomowisku">
	<main class="flex min-h-screen flex-col items-center justify-center gap-3 p-2 sm:p-4">
		<h1 class="title text-4xl tracking-wider sm:text-5xl">ŚRUBEK</h1>

		<div id="stage" class="relative w-full max-w-[960px]">
			<canvas id="game" width="960" height="512" class="block w-full rounded-lg bg-neutral-900 shadow-2xl" aria-label="Gra Śrubek"></canvas>
			<div id="pad" hidden class="pad"></div>
			<div class="float-btns">
				<button id="float-menu" type="button" class="float-btn" aria-label="Menu">☰</button>
				<button id="float-fullscreen" type="button" class="float-btn" aria-label="Pełny ekran">⤢</button>
			</div>

			<div id="menu" class="menu">
				<div class="menu-panel">
					<h2 class="title text-3xl tracking-wider">SZAFA ŚRUBKA</h2>
					<p class="hint text-sm tracking-wide text-amber-200/80">Wybierz gotowy strój albo złóż własny. Śrubek po lewej od razu go przymierza.</p>
					<div id="presets" class="flex flex-wrap gap-2"></div>
					<div class="grid grid-cols-3 gap-2">
						<label class="hint flex flex-col gap-1 text-sm tracking-wide text-amber-100">Korpus
							<input id="skin-body" type="color" class="h-8 w-full cursor-pointer rounded border border-amber-300/40 bg-neutral-900" />
						</label>
						<label class="hint flex flex-col gap-1 text-sm tracking-wide text-amber-100">Oczy
							<input id="skin-eyes" type="color" class="h-8 w-full cursor-pointer rounded border border-amber-300/40 bg-neutral-900" />
						</label>
						<label class="hint flex flex-col gap-1 text-sm tracking-wide text-amber-100">Dodatki
							<input id="skin-accent" type="color" class="h-8 w-full cursor-pointer rounded border border-amber-300/40 bg-neutral-900" />
						</label>
						<label class="hint col-span-3 flex flex-col gap-1 text-sm tracking-wide text-amber-100 sm:col-span-1">W ręce
							<select id="skin-hand" class="h-8 rounded border border-amber-300/40 bg-neutral-900 px-2 text-sm text-amber-50"></select>
						</label>
						<label class="hint col-span-3 flex flex-col gap-1 text-sm tracking-wide text-amber-100 sm:col-span-1">Na głowie
							<select id="skin-hat" class="h-8 rounded border border-amber-300/40 bg-neutral-900 px-2 text-sm text-amber-50"></select>
						</label>
						<label class="hint col-span-3 flex flex-col gap-1 text-sm tracking-wide text-amber-100 sm:col-span-1">Dodatek
							<select id="skin-accessory" class="h-8 rounded border border-amber-300/40 bg-neutral-900 px-2 text-sm text-amber-50"></select>
						</label>
					</div>
					<details class="keys">
						<summary class="hint cursor-pointer text-lg tracking-wide text-amber-100">Sterowanie: kliknij czynność i naciśnij nowy klawisz</summary>
						<div id="keys" class="mt-2 grid grid-cols-1 gap-1.5 sm:grid-cols-2"></div>
						<button id="keys-reset" type="button" class="hint mt-2 rounded border border-amber-300/40 bg-neutral-900 px-3 py-1 text-sm tracking-wide text-amber-100 hover:border-amber-300">Klawisze domyślne</button>
					</details>
					<button id="play" type="button" class="title mt-1 rounded-lg border-2 border-amber-300/60 bg-neutral-950/80 px-6 py-2 text-3xl tracking-wider hover:border-amber-200">GRAJ</button>
					<p class="text-xs text-neutral-400">Strój i klawisze zapisują się w tej przeglądarce. Esc albo przycisk Menu wraca tutaj.</p>
				</div>
			</div>
		</div>

		<div class="flex flex-wrap justify-center gap-2">
			<button id="fullscreen" type="button" class="hint rounded border border-amber-300/40 bg-neutral-900 px-3 py-1 text-base tracking-wide text-amber-100 hover:border-amber-300">Pełny ekran</button>
			<button id="open-menu" type="button" class="hint rounded border border-amber-300/40 bg-neutral-900 px-3 py-1 text-base tracking-wide text-amber-100 hover:border-amber-300">Menu</button>
			<button id="toggle-pad" type="button" class="hint rounded border border-amber-300/40 bg-neutral-900 px-3 py-1 text-base tracking-wide text-amber-100 hover:border-amber-300">Przyciski na ekranie</button>
		</div>

		<p id="key-hint" class="hint max-w-[960px] text-center text-sm tracking-wide text-amber-200/80 sm:text-base">strzałki / WASD: jazda · spacja: skok (przytrzymaj, by skoczyć wyżej; w locie raz jeszcze) · C: magnes zbiera złom (do 10 szt.) · X: rzut złomem · Z: mega kula (za 10 śrub) · Shift / V: cios przedmiotem z ręki · M: dźwięk · mysz: trzymaj lewy, by jechać w stronę kursora, prawy skok, środkowy rzut</p>

	</main>

	<div id="rotate" class="rotate">
		<div class="phone"></div>
		<p class="hint text-2xl tracking-wide text-amber-100">Obróć telefon poziomo, żeby grać</p>
	</div>

	<div id="score-modal" hidden class="fixed inset-0 z-[60] flex items-center justify-center bg-black/60 p-4">
		<form id="score-form" class="flex w-full max-w-md flex-col gap-3 rounded-xl border border-amber-300/40 bg-neutral-950/95 p-5 shadow-2xl">
			<h2 class="title text-3xl tracking-wider">ZAPISZ WYNIK</h2>
			<p id="score-note" class="hint text-lg tracking-wide text-amber-100"></p>
			<div class="flex gap-2">
				<input id="score-nick" name="nick" required autocomplete="off" placeholder="ksywka" class="min-w-0 flex-1 rounded border border-amber-300/40 bg-neutral-900 px-3 py-1 text-amber-50 outline-none focus:border-amber-300" />
				<button type="submit" class="hint rounded bg-amber-400 px-4 py-1 text-lg tracking-wide text-neutral-950 hover:bg-amber-300">Zapisz</button>
			</div>
			<p class="text-xs text-neutral-400">Tablica jest publiczna: każdy, kto zna adres, zobaczy ksywkę.</p>
		</form>
	</div>
</Layout>

<style is:global>
	/* Bangers, SIL Open Font License — public/fonts/Bangers-OFL.txt */
	@font-face {
		font-family: "Bangers";
		src: url("/fonts/Bangers-Regular.ttf") format("truetype");
		font-display: swap;
	}
	.title,
	.hint {
		font-family: "Bangers", "Impact", sans-serif;
	}
	.title {
		background: linear-gradient(180deg, #fff2b0 0%, #ffb347 45%, #ff6a3d 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 3px 0 #3a1a10) drop-shadow(0 0 12px rgba(255, 150, 60, 0.45));
	}
	[hidden] {
		display: none !important;
	}
	#game,
	#stage {
		touch-action: none;
		-webkit-touch-callout: none;
		-webkit-user-select: none;
		user-select: none;
	}
	.no-scroll,
	.no-scroll body {
		overflow: hidden;
		overscroll-behavior: none;
	}

	/* Fullscreen (native or pinned): black stage, canvas letterboxed to the screen, pad on top. */
	#stage.is-fullscreen {
		position: fixed;
		inset: 0;
		z-index: 40;
		width: auto;
		max-width: none;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #000;
	}
	#stage.is-fullscreen #game {
		width: min(100vw, calc(100dvh * 960 / 512));
		height: auto;
		border-radius: 0;
		box-shadow: none;
	}
	/* Touch controls: the stage's halves are the stick and the jump button, actions sit on the right edge. */
	.pad {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.zone {
		position: absolute;
		top: 0;
		bottom: 0;
		pointer-events: auto;
		touch-action: none;
		-webkit-tap-highlight-color: transparent;
	}
	.zone-move {
		left: 0;
		width: 45%;
	}
	.zone-jump {
		right: 0;
		width: 55%;
	}
	.zone-label {
		position: absolute;
		bottom: max(0.8rem, env(safe-area-inset-bottom));
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
		pointer-events: none;
		font-family: "Bangers", "Impact", sans-serif;
		font-size: 1.1rem;
		letter-spacing: 0.05em;
		color: rgba(255, 233, 168, 0.8);
		text-shadow: 0 2px 0 #000;
		transition: opacity 0.6s;
	}
	.pad.learned .zone-label {
		opacity: 0;
	}
	.stick,
	.knob {
		position: absolute;
		display: none;
		border-radius: 999px;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}
	.stick {
		width: 6rem;
		height: 6rem;
		border: 2px solid rgba(255, 210, 120, 0.45);
		background: rgba(20, 16, 30, 0.3);
	}
	.knob {
		width: 2.8rem;
		height: 2.8rem;
		background: rgba(255, 180, 70, 0.7);
	}
	.zone-move.is-down .stick,
	.zone-move.is-down .knob {
		display: block;
	}
	/* Only a marker: the whole right half jumps. Shown when the stage has side strips. */
	.jump-btn {
		display: none;
		position: absolute;
		width: 4.6rem;
		height: 4.6rem;
		align-items: center;
		justify-content: center;
		border: 2px solid rgba(255, 210, 120, 0.55);
		border-radius: 999px;
		background: rgba(20, 16, 30, 0.55);
		color: #ffe9a8;
		font-size: 1.8rem;
		pointer-events: none;
	}
	.zone-jump.is-down .jump-btn {
		background: rgba(255, 180, 70, 0.75);
		color: #1b1a22;
	}
	.actions {
		position: absolute;
		right: max(0.6rem, env(safe-area-inset-right));
		top: 50%;
		transform: translateY(-50%);
		display: grid;
		grid-template-columns: repeat(2, 3.2rem);
		grid-auto-rows: 3.2rem;
		gap: 0.5rem;
		pointer-events: auto;
	}
	.pad-btn {
		pointer-events: auto;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
		border: 2px solid rgba(255, 210, 120, 0.55);
		border-radius: 0.6rem;
		background: rgba(20, 16, 30, 0.55);
		color: #ffe9a8;
		font-family: "Bangers", "Impact", sans-serif;
		font-size: 1.6rem;
		letter-spacing: 0.05em;
		backdrop-filter: blur(2px);
		-webkit-tap-highlight-color: transparent;
	}
	.pad-btn.is-down {
		background: rgba(255, 180, 70, 0.75);
		color: #1b1a22;
	}

	/* Start menu over the right side of the stage; the left stays clear so Śrubek shows. */
	.menu {
		position: absolute;
		inset: 0;
		display: flex;
		justify-content: flex-end;
		align-items: stretch;
		background: linear-gradient(90deg, rgba(5, 4, 12, 0) 0%, rgba(5, 4, 12, 0.55) 30%, rgba(5, 4, 12, 0.85) 45%);
		border-radius: 0.5rem;
	}
	.menu-panel {
		width: 62%;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1rem 1.2rem;
		overflow-y: auto;
		overscroll-behavior: contain;
	}
	@media (max-width: 640px) {
		.menu {
			background: rgba(5, 4, 12, 0.85);
		}
		.menu-panel {
			width: 100%;
			padding: 0.6rem;
			gap: 0.4rem;
		}
	}

	/* Wardrobe presets: a swatch of the shell colour with the accent as a stripe. */
	.preset {
		font-family: "Bangers", "Impact", sans-serif;
		letter-spacing: 0.05em;
		font-size: 1.1rem;
		padding: 0.3rem 0.8rem 0.3rem 2rem;
		border-radius: 0.5rem;
		border: 1px solid rgba(255, 210, 120, 0.4);
		color: #fff4d6;
		background:
			linear-gradient(90deg, var(--c) 0 1.4rem, var(--a) 1.4rem 1.7rem, rgba(20, 16, 30, 0.8) 1.7rem);
	}
	.preset:hover {
		border-color: #ffd27a;
	}
	.keybind {
		font-family: "Bangers", "Impact", sans-serif;
		letter-spacing: 0.05em;
		font-size: 1rem;
		text-align: left;
		padding: 0.2rem 0.6rem;
		border-radius: 0.4rem;
		border: 1px solid rgba(255, 210, 120, 0.4);
		background: rgba(20, 16, 30, 0.8);
		color: #fff4d6;
	}
	.keybind:hover,
	.keybind:focus-visible {
		border-color: #ffd27a;
	}
	/* Phones and tablets play on the touch pad; the keyboard section only takes room there. */
	@media (pointer: coarse) {
		.keys {
			display: none;
		}
	}

	/* Small round buttons in the stage's corner, for when the page around it is out of reach. */
	.float-btns {
		display: none;
		position: absolute;
		top: max(6px, env(safe-area-inset-top));
		right: max(6px, env(safe-area-inset-right));
		gap: 6px;
		z-index: 5;
	}
	.float-btn {
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 999px;
		border: 2px solid rgba(255, 210, 120, 0.55);
		background: rgba(20, 16, 30, 0.6);
		color: #ffe9a8;
		font-size: 1.2rem;
		line-height: 1;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
	}
	#stage.is-fullscreen .float-btns {
		display: flex;
	}

	/* Upright phones get a request to turn; the game stays paused behind it. */
	.rotate {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 70;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.2rem;
		padding: 2rem;
		text-align: center;
		background: #0b0912;
	}
	.phone {
		width: 2.8rem;
		height: 4.8rem;
		border: 4px solid #ffb347;
		border-radius: 0.7rem;
		animation: turn 1.8s ease-in-out infinite;
	}
	@keyframes turn {
		0%,
		30% {
			transform: rotate(0deg);
		}
		60%,
		100% {
			transform: rotate(-90deg);
		}
	}

	/* Double taps must not zoom the page; iOS also zooms into any field under 16px. */
	html {
		touch-action: manipulation;
	}
	@media (pointer: coarse) {
		.float-btns {
			display: flex;
		}
		input,
		select {
			font-size: 16px !important;
		}
	}
	@media (pointer: coarse) and (orientation: portrait) {
		.rotate {
			display: flex;
		}
	}

	/* Phones and tablets held sideways: the stage owns the whole screen. */
	@media (pointer: coarse) and (orientation: landscape) {
		html,
		body {
			overflow: hidden;
			overscroll-behavior: none;
		}
		main {
			padding: 0 !important;
		}
		main > :not(#stage) {
			display: none !important;
		}
		#stage {
			position: fixed;
			inset: 0;
			z-index: 40;
			width: auto;
			max-width: none;
			display: flex;
			align-items: center;
			justify-content: center;
			background: #000;
			/* Each black strip beside the canvas: the notch inset plus room for the stick or the buttons. */
			--edge: max(0.4rem, env(safe-area-inset-left), env(safe-area-inset-right));
			--side: 7.2rem;
		}
		#stage #game,
		#stage.is-fullscreen #game {
			width: min(100vw - 2 * (var(--edge) + var(--side)), calc(100dvh * 960 / 512));
			height: auto;
			border-radius: 0;
			box-shadow: none;
		}
		.stick,
		.knob {
			display: block;
			left: calc(var(--edge) + var(--side) / 2);
			top: 60%;
		}
		.jump-btn {
			display: flex;
			right: calc(var(--edge) + (var(--side) - 4.6rem) / 2);
			bottom: max(0.8rem, env(safe-area-inset-bottom));
		}
		.actions {
			right: calc(var(--edge) + (var(--side) - 6.9rem) / 2);
			top: 42%;
		}
		.menu {
			border-radius: 0;
		}
		.menu-panel {
			width: 70%;
			gap: 0.35rem;
			padding: 0.5rem 3.6rem 0.5rem 0.8rem;
			/* The stage blocks gestures for the game; the menu must still scroll. */
			touch-action: pan-y;
		}
		.menu-panel > h2 {
			order: -2;
			font-size: 1.5rem;
		}
		#play {
			order: -1;
			margin: 0;
			padding: 0.15rem 1rem;
			font-size: 1.6rem;
		}
		.menu-panel > p {
			display: none;
		}
		.preset {
			font-size: 0.9rem;
			padding: 0.15rem 0.5rem 0.15rem 1.6rem;
		}
	}
</style>

<script>
	import { mountBoard } from "@/board";
	import { lockPage, mountFullscreen, mountMouse, mountPad, touchDevice } from "@/controls";
	import { type Game, start } from "@/game/main";
	import { mountKeys } from "@/keys";
	import { mountWardrobe } from "@/wardrobe";

	const canvas = document.getElementById("game");
	const presets = document.getElementById("presets");
	const skinBody = document.getElementById("skin-body");
	const skinEyes = document.getElementById("skin-eyes");
	const skinAccent = document.getElementById("skin-accent");
	const skinHat = document.getElementById("skin-hat");
	const skinAccessory = document.getElementById("skin-accessory");
	const skinHand = document.getElementById("skin-hand");
	const stage = document.getElementById("stage");
	const pad = document.getElementById("pad");
	const fullscreen = document.getElementById("fullscreen");
	const togglePad = document.getElementById("toggle-pad");
	const menu = document.getElementById("menu");
	const play = document.getElementById("play");
	const openMenu = document.getElementById("open-menu");
	const floatMenu = document.getElementById("float-menu");
	const floatFullscreen = document.getElementById("float-fullscreen");
	const modal = document.getElementById("score-modal");
	const form = document.getElementById("score-form");
	const nick = document.getElementById("score-nick");
	const note = document.getElementById("score-note");
	const keys = document.getElementById("keys");
	const keysReset = document.getElementById("keys-reset");
	const keyHint = document.getElementById("key-hint");

	if (
		canvas instanceof HTMLCanvasElement &&
		stage instanceof HTMLElement &&
		pad instanceof HTMLElement &&
		fullscreen instanceof HTMLButtonElement &&
		togglePad instanceof HTMLButtonElement &&
		menu instanceof HTMLElement &&
		play instanceof HTMLButtonElement &&
		openMenu instanceof HTMLButtonElement &&
		floatMenu instanceof HTMLButtonElement &&
		floatFullscreen instanceof HTMLButtonElement &&
		modal instanceof HTMLElement &&
		form instanceof HTMLFormElement &&
		nick instanceof HTMLInputElement &&
		note instanceof HTMLElement &&
		presets instanceof HTMLElement &&
		skinBody instanceof HTMLInputElement &&
		skinEyes instanceof HTMLInputElement &&
		skinAccent instanceof HTMLInputElement &&
		skinHat instanceof HTMLSelectElement &&
		skinAccessory instanceof HTMLSelectElement &&
		skinHand instanceof HTMLSelectElement &&
		keys instanceof HTMLElement &&
		keysReset instanceof HTMLButtonElement &&
		keyHint instanceof HTMLElement
	) {
		let game: Game | undefined;
		const board = mountBoard({ modal, form, nick, note }, (rows) => game?.setBoard(rows));
		mountFullscreen(stage, fullscreen);
		if (touchDevice()) lockPage();
		// The canvas draws its own text, so the font must be in before the first frame.
		document.fonts.load("20px Bangers").finally(() => {
			game = start(canvas, { onEnd: (state) => board.offer(state), onRestart: () => board.hide() });
			void board.refresh();
			const showPad = mountPad(pad, game);
			let padOn = touchDevice();
			showPad(padOn);
			togglePad.addEventListener("click", () => {
				padOn = !padOn;
				showPad(padOn);
			});
			mountMouse(canvas, game);
			const g = game;
			const setMenu = (open: boolean): void => {
				menu.hidden = !open;
				g.setPaused(open);
			};
			setMenu(true);
			play.addEventListener("click", () => setMenu(false));
			openMenu.addEventListener("click", () => setMenu(true));
			floatMenu.addEventListener("click", () => setMenu(true));
			floatFullscreen.addEventListener("click", () => fullscreen.click());			// Turning a phone upright hides the stage behind the rotate prompt, so pause into the menu.
			const upright = window.matchMedia("(pointer: coarse) and (orientation: portrait)");
			upright.addEventListener("change", () => {
				if (upright.matches) setMenu(true);
			});
			window.addEventListener("keydown", (e) => {
				if (e.code === "Escape") setMenu(menu.hidden);
				else if (e.code === "Enter" && !menu.hidden && !(e.target instanceof HTMLInputElement)) setMenu(false);
			});
			mountWardrobe(
				{ presets, body: skinBody, eyes: skinEyes, accent: skinAccent, hat: skinHat, accessory: skinAccessory, hand: skinHand },
				game,
			);
			mountKeys({ list: keys, reset: keysReset, hint: keyHint }, game);
		});
	}
</script>
