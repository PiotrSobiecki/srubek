{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "astro-on-cf",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		// Routing knobs, left at their defaults on purpose. They are spelled out so
		// the current behaviour reads as a decision rather than an oversight, and so
		// the options are discoverable without a trip to the docs.
		//
		// /about and /about/ resolve alike:
		// "html_handling": "auto-trailing-slash",
		//
		// A miss falls through to the Worker, which is what SSR wants; a 404-page
		// value would shadow every dynamic route:
		// "not_found_handling": "none",
		//
		// Static assets are served without waking the Worker, so billed CPU tracks
		// real SSR only:
		// "run_worker_first": false,
		//
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Uploads the .js.map files emitted by the build (astro.config.mjs sets
	// vite.build.sourcemap) so observability traces name real source lines
	// instead of minified output.
	"upload_source_maps": true,
	"vars": {
		"CLOUDFLARE_ENV": "dev"
	},
	// Optional bindings — uncomment what you need. Every commented entry below is
	// complete and comma-terminated, so uncommenting one leaves valid JSONC without
	// any further edit. scripts/wrangler-config.test.ts enables them all and parses
	// the result, so that stays true.
	//
	// Scheduled jobs:
	// "triggers": { "crons": ["0 * * * *"] },
	//
	// KV namespaces. SESSION is not optional the way the others are:
	// @astrojs/cloudflare emits a SESSION binding into its generated config whether
	// or not you declare one, and the copy it emits carries no namespace id — so the
	// first deploy of a clone that touches Astro sessions fails for want of one.
	// Declare it here and the adapter uses yours instead. Create the namespace with
	// `wrangler kv namespace create SESSION`, then paste the id it prints.
	// "kv_namespaces": [
	//   { "binding": "SESSION", "id": "<kv-namespace-id>" },
	//   { "binding": "CACHE", "id": "<kv-namespace-id>" }
	// ],
	//
	// Queues:
	// "queues": { "producers": [{ "binding": "QUEUE", "queue": "my-queue" }] },
	//
	"env": {
		"dev": {
			"name": "astro-on-cf-dev",
			"vars": {
				"CLOUDFLARE_ENV": "dev"
			}
		},
		"staging": {
			"name": "astro-on-cf-staging",
			"vars": {
				"CLOUDFLARE_ENV": "staging"
			}
		},
		"production": {
			"name": "astro-on-cf-production",
			"vars": {
				"CLOUDFLARE_ENV": "production"
			}
		}
	}
}
